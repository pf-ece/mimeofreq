ARM GAS  C:\Users\pisaa\AppData\Local\Temp\ccgIcmMr.s 			page 18


  65:../../DaisySP//Source/Utility/dsp.h **** {
  66:../../DaisySP//Source/Utility/dsp.h ****     return fmin(fmax(in, min), max);
