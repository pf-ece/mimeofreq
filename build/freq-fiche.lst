   3:freq-fiche.cpp **** 
   4:freq-fiche.cpp **** // Set maximum delay time
   5:freq-fiche.cpp **** #define MAX_DELAY static_cast<size_t>(48000)
   6:freq-fiche.cpp **** 
   7:freq-fiche.cpp **** using namespace daisy;
   8:freq-fiche.cpp **** using namespace daisy::seed;
   9:freq-fiche.cpp **** using namespace daisysp;
  10:freq-fiche.cpp **** 
  11:freq-fiche.cpp **** // Potentiometer definitions
  12:freq-fiche.cpp **** #define POT_MIX  A0
  13:freq-fiche.cpp **** #define POT_FB 	 A1
  14:freq-fiche.cpp **** #define POT_TIME A2
  15:freq-fiche.cpp **** 
  16:freq-fiche.cpp **** // ADC channel declarations
  17:freq-fiche.cpp **** enum AdcChannel {
ARM GAS  C:\Users\pisaa\AppData\Local\Temp\ccgIcmMr.s 			page 10


  18:freq-fiche.cpp **** 	knobOne,
  19:freq-fiche.cpp **** 	knobTwo,
  20:freq-fiche.cpp **** 	knobThree,
  21:freq-fiche.cpp **** 	NUM_ADC_CHANNELS
  22:freq-fiche.cpp **** };
  23:freq-fiche.cpp **** 
  24:freq-fiche.cpp **** static DaisySeed hw;
  25:freq-fiche.cpp **** 
  26:freq-fiche.cpp **** // Knob setting initializations
  27:freq-fiche.cpp **** float mix = 0.5f;
  28:freq-fiche.cpp **** float feedback_lvl = 0.5f;
  29:freq-fiche.cpp **** float delay_time = 0.5f;
  30:freq-fiche.cpp **** 
  31:freq-fiche.cpp **** // ADC declarations
  32:freq-fiche.cpp **** void initADC();
  33:freq-fiche.cpp **** void procADC();
  34:freq-fiche.cpp **** 
  35:freq-fiche.cpp **** // Declare DelayLine with MAX_DELAY number of samples.
  36:freq-fiche.cpp **** static DelayLine<float, MAX_DELAY> del_l, del_r;
  37:freq-fiche.cpp **** 
  38:freq-fiche.cpp **** static void AudioCallback(AudioHandle::InputBuffer in, AudioHandle::OutputBuffer out, size_t size)
  39:freq-fiche.cpp **** {
  40:freq-fiche.cpp ****     float dry_l, dry_r, wet_l, wet_r;
  41:freq-fiche.cpp **** 
  42:freq-fiche.cpp ****     procADC();
  43:freq-fiche.cpp **** 
  44:freq-fiche.cpp ****     // Set Delay time (samples)
  45:freq-fiche.cpp ****     float time_N = delay_time * MAX_DELAY;
  46:freq-fiche.cpp ****     del_l.SetDelay(time_N);
  47:freq-fiche.cpp ****     del_r.SetDelay(time_N);
  48:freq-fiche.cpp **** 
  49:freq-fiche.cpp ****     for(size_t i = 0; i < size; i++)
  50:freq-fiche.cpp ****     {
  51:freq-fiche.cpp ****         // Read dry input signal
  52:freq-fiche.cpp ****         dry_l = in[0][i];
  53:freq-fiche.cpp ****         dry_r = in[1][i];
  54:freq-fiche.cpp **** 
  55:freq-fiche.cpp ****         // Read previous wet (delayed) signal
  56:freq-fiche.cpp ****         wet_l = del_l.Read();
  57:freq-fiche.cpp ****         wet_r = del_r.Read();
  58:freq-fiche.cpp **** 
  59:freq-fiche.cpp ****         // Write next delayed signal (feedback loop)
  60:freq-fiche.cpp ****         del_l.Write(dry_l + (wet_l * feedback_lvl));
  61:freq-fiche.cpp ****         del_r.Write(dry_r + (wet_r * feedback_lvl));
  62:freq-fiche.cpp **** 
  63:freq-fiche.cpp ****         // Mix dry/wet signals, write as output
  64:freq-fiche.cpp ****         out[0][i] = (dry_l * (1.0f - mix)) + (wet_l * mix);
  65:freq-fiche.cpp ****         out[1][i] = (dry_r * (1.0f - mix)) + (wet_r * mix);
  66:freq-fiche.cpp ****     }
  67:freq-fiche.cpp **** }
  68:freq-fiche.cpp **** 
  69:freq-fiche.cpp **** int main(void)
  70:freq-fiche.cpp **** {
  71:freq-fiche.cpp ****     // Initializations
  72:freq-fiche.cpp ****     // float sample_rate;
  73:freq-fiche.cpp ****     hw.Configure();
  74:freq-fiche.cpp ****     hw.Init();
ARM GAS  C:\Users\pisaa\AppData\Local\Temp\ccgIcmMr.s 			page 11


  75:freq-fiche.cpp ****     hw.SetAudioBlockSize(4);
  76:freq-fiche.cpp ****     // sample_rate = hw.AudioSampleRate();
  77:freq-fiche.cpp **** 
  78:freq-fiche.cpp **** 	initADC();
  79:freq-fiche.cpp **** 
  80:freq-fiche.cpp ****     del_l.Init();
  81:freq-fiche.cpp ****     del_r.Init();
  82:freq-fiche.cpp **** 
  83:freq-fiche.cpp ****     // Start callback
  84:freq-fiche.cpp ****     hw.StartAudio(AudioCallback);
  85:freq-fiche.cpp **** 
  86:freq-fiche.cpp ****     while(1) {}
  87:freq-fiche.cpp **** }
